    wrap.innerHTML=out;
    updateHomeWarn();
  }
  function cartOverlaps(){
    function norm(s){ return s.toLowerCase().replace(/[^a-z0-9 ]/g,' ').replace(/\s+/g,' ').trim(); }
    var pkgs=CART.filter(function(it){ return !!INC[it.name]; });
    var res=[];
    if(!pkgs.length) return res;
    CART.forEach(function(it){
      if(INC[it.name]) return;              // the item is itself a package
      var cands=[norm(it.name), norm(it.name.replace(/\(.*?\)/g,''))];
      var acr=(it.name.match(/\(([A-Za-z0-9\/]{2,6})\)/)||[])[1]; if(acr) cands.push(norm(acr));
      cands=cands.filter(function(c){return c.length>=3;});
      pkgs.forEach(function(pk){
        var inc=' '+norm(INC[pk.name])+' ';
        var hit=cands.some(function(c){ return inc.indexOf(' '+c+' ')>=0 || inc.indexOf(c)>=0; });
        if(hit) res.push({test:it.name, pkg:pk.name});
      });
    });
    return res;
  }

  // Intercept any "Book" trigger → adds the test to the cart and opens checkout (which shows the whole cart).
  document.addEventListener('click', function(e){
    if(!BOOKING_LIVE) return;                       // dormant: let the WhatsApp href work as normal
    var t = e.target.closest('[data-book-name]');
    if(!t) return;
    e.preventDefault();
    e.stopPropagation();                            // don't also fire the WhatsApp-click tracker
    var price = t.getAttribute('data-book-price');
    openBooking(t.getAttribute('data-book-name'), price===""?null:Number(price), t.getAttribute('data-book-code')||"");
  }, true);

  // "＋ Add" trigger → adds to cart, keeps the patient browsing.
  document.addEventListener('click', function(e){
    if(!BOOKING_LIVE) return;
    var a = e.target.closest('[data-add-name]');
    if(!a) return;
    e.preventDefault(); e.stopPropagation();
    var p = a.getAttribute('data-add-price');
    cartAdd(a.getAttribute('data-add-name'), p===""?null:Number(p), a.getAttribute('data-add-code')||"");
    a.classList.add('added'); var prev=a.textContent; a.textContent='✓';
    setTimeout(function(){ a.classList.remove('added'); a.textContent='＋'; }, 1200);
  }, true);

  // Single-test "Book": ensure it's in the cart, then open checkout with the full cart.
  function openBooking(name, price, code){
    if(cartFind(name)<0){ CART.push({ name:name, price:(price==null||price===""?null:Number(price)), code:code||"" }); }
    updateSticky();
    openCart();
  }

  // Open the checkout modal showing every test in the cart.
  function openCart(){
    if(!CART.length){ scrollToTests(); return; }
    bkState.mode = "now";
    document.getElementById('bkTitle').textContent = CART.length>1 ? "Book your tests" : "Book your test";
    document.getElementById('bkErr').style.display = "none";
    document.getElementById('bkForm').reset();
    document.getElementById('bkFormWrap').style.display = "";
    document.getElementById('bkDone').style.display = "none";
    document.getElementById('bkDone').innerHTML = "";
    renderBkItems();
    setMode('now');
    try{ var d=new Date(); d.setSeconds(0,0); var pad=function(x){return(x<10?'0':'')+x;};
      document.getElementById('bkTime').min = d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes()); }catch(e){}
    var sub = document.getElementById('bkSub'); sub.disabled=false; sub.textContent="Confirm booking";
    document.getElementById('bkOv').classList.add('on');
    document.body.style.overflow = "hidden";
    bkReturnFocus = document.activeElement;               // remember trigger to restore focus on close
    setTimeout(function(){ try{ document.getElementById('bkName').focus(); }catch(e){} }, 60);
    if(typeof gtag==='function'){gtag('event','booking_open',{event_category:'booking'});}  // no test name (health-data privacy)
  }
  var bkReturnFocus=null;
  function closeBooking(){
    document.getElementById('bkOv').classList.remove('on');
    document.body.style.overflow = "";
    if(bkReturnFocus && bkReturnFocus.focus){ try{ bkReturnFocus.focus(); }catch(e){} bkReturnFocus=null; }
  }
  // close on backdrop click / Esc (Esc also closes the share popover)
  document.getElementById('bkOv').addEventListener('click', function(e){ if(e.target===this) closeBooking(); });
  document.addEventListener('keydown', function(e){
    if(e.key==='Escape'){ closeSharePop(); if(document.getElementById('dtOv').classList.contains('on')) closeDetail(); if(document.getElementById('bkOv').classList.contains('on')) closeBooking(); }
  });
  // Simple focus trap: keep Tab within the open dialog
  document.getElementById('bkOv').addEventListener('keydown', function(e){
    if(e.key!=='Tab') return;
    var f=this.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    f=Array.prototype.filter.call(f, function(el){ return el.offsetParent!==null && !el.disabled; });
    if(!f.length) return;
    var first=f[0], last=f[f.length-1];
    if(e.shiftKey && document.activeElement===first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement===last){ e.preventDefault(); first.focus(); }
  });

  function updateHomeWarn(){
    var w=document.getElementById('bkHomeWarn'); if(!w) return;
    if(bkState.mode!=='home'){ w.style.display='none'; return; }
    var t=cartTotal();
    if(t.unknown){ w.textContent='Home collection is free on orders above ₹500. If your order is below that, a small visit charge applies — our team will confirm.'; w.style.display=''; }
    else if(t.t>0 && t.t<500){ w.textContent='Your order is '+inr(t.t)+'. Home collection is free above ₹500 — below that a small visit charge applies, which our team will confirm.'; w.style.display=''; }
    else { w.style.display='none'; }
  }
  function setMode(m){
    bkState.mode = m;
    Array.prototype.forEach.call(document.querySelectorAll('#bkModes .bk-mode'), function(el){
      var on = el.getAttribute('data-mode')===m;
      el.classList.toggle('on', on);
      el.setAttribute('aria-checked', on?'true':'false');
      el.setAttribute('tabindex', on?'0':'-1');   // roving tabindex
    });
    document.getElementById('bkAddrWrap').style.display = (m==='home') ? "" : "none";
    document.getElementById('bkTimeWrap').style.display = (m==='home'||m==='scheduled') ? "" : "none";
    updateHomeWarn();
  }
  (function(){
    var modes=Array.prototype.slice.call(document.querySelectorAll('#bkModes .bk-mode'));
    modes.forEach(function(el, idx){
      el.setAttribute('role','radio');
      el.setAttribute('tabindex', el.classList.contains('on')?'0':'-1');
      el.addEventListener('click', function(){ setMode(el.getAttribute('data-mode')); });
      el.addEventListener('keydown', function(ev){
        if(ev.key==='Enter'||ev.key===' '){ ev.preventDefault(); setMode(el.getAttribute('data-mode')); return; }
        var dir = (ev.key==='ArrowRight'||ev.key==='ArrowDown')?1:(ev.key==='ArrowLeft'||ev.key==='ArrowUp')?-1:0;
        if(dir){ ev.preventDefault(); var ni=(idx+dir+modes.length)%modes.length; var next=modes[ni]; setMode(next.getAttribute('data-mode')); next.focus(); }
      });
    });
  })();

  // Build a rich WhatsApp fallback message (used whenever the API can't complete the booking).
  function bkWhatsAppUrl(v){
    var L = [];
    L.push("Hi Caspian Diagnostic Centre, I'd like to book:");
    CART.forEach(function(it){ L.push("• " + it.name + (it.price!=null ? " (" + inr(it.price) + ")" : "")); });
    if(v.name)   L.push("Name: " + v.name);
    if(v.age||v.gender) L.push("Age/Gender: " + [v.age, v.gender].filter(Boolean).join(" / "));
    if(v.mobile) L.push("Mobile: " + v.mobile);
    if(v.email)  L.push("Email: " + v.email);
    var modeTxt = {now:"At the centre", home:"Home collection", scheduled:"Preferred slot"}[v.mode] || v.mode;
    L.push("Preference: " + modeTxt);
    if(v.mode==='home' && v.address) L.push("Address: " + v.address);
    if((v.mode==='home'||v.mode==='scheduled') && v.dateTime) L.push("Time: " + v.dateTime.replace('T',' '));
    return WA + encodeURIComponent(L.join("\n"));
  }
  function bkFallback(v, reason){
    if(typeof gtag==='function'){gtag('event','booking_fallback_whatsapp',{event_category:'booking',event_label:reason||'',});}
    if(typeof fbq==='function'){fbq('track','Lead',{content_name:'booking_whatsapp_fallback'});}
    var url = bkWhatsAppUrl(v);
    var done = document.getElementById('bkDone');
    document.getElementById('bkFormWrap').style.display = "none";
    done.style.display = "";
    done.innerHTML = '<div class="tick" style="background:#e7f7ee;color:#25D366">💬</div>'
      + '<h4>Almost done!</h4>'
      + '<p>Tap below to send your booking to our team on WhatsApp — we\'ll confirm your slot right away.</p>'
      + '<a class="btn-wa2" href="'+url+'" target="_blank" rel="noopener">Confirm on WhatsApp</a>';
    // best-effort auto-open so a tap isn't strictly required
    try { window.open(url, '_blank', 'noopener'); } catch(err){}
  }

  // Timeout is special: the booking MAY have gone through server-side, so we must NOT push the
  // patient to place a fresh WhatsApp order (that would double-book). Ask them not to resubmit.
  function bkTimeout(v){
    if(typeof gtag==='function'){gtag('event','booking_timeout',{event_category:'booking'});}
    var _tnames = CART.map(function(it){return it.name;}).join(", ") || "a test";
    var statusMsg = "Hi Caspian Diagnostic Centre, I just tried to book "+_tnames+" online (name: "+v.name+", mobile: "+v.mobile+"). My page timed out — could you please confirm whether my booking went through? I don't want to book twice.";
    var url = WA + encodeURIComponent(statusMsg);
    var done = document.getElementById('bkDone');
    document.getElementById('bkFormWrap').style.display = "none";
    done.style.display = "";
    done.innerHTML = '<div class="tick" style="background:#fff4e0;color:#e08a00">⏳</div>'
      + '<h4>Still processing…</h4>'
      + '<p>Your request is taking longer than usual. <b>Please don\'t book again</b> — it may already be registered. Our team will confirm on your phone (<b>'+esc(v.mobile)+'</b>) shortly.</p>'
      + '<a class="btn-wa2" href="'+url+'" target="_blank" rel="noopener">Check status on WhatsApp</a>';
    CART=[]; saveCart(); updateSticky();   // clear so the patient can't resubmit the same order
  }

  document.getElementById('bkForm').addEventListener('submit', function(e){
    e.preventDefault();
    var v = {
      name:   document.getElementById('bkName').value.trim(),
      mobile: document.getElementById('bkMobile').value.replace(/\D/g,''),
      age:    document.getElementById('bkAge').value.trim(),
      gender: document.getElementById('bkGender').value,
      email:  document.getElementById('bkEmail').value.trim(),
      mode:   bkState.mode,
      address:document.getElementById('bkAddr').value.trim(),
      dateTime:document.getElementById('bkTime').value
    };
    var err = document.getElementById('bkErr');
    function fail(m){ err.textContent = m; err.style.display="block"; }
    if(!v.name){ return fail("Please enter the patient's full name."); }
    if(!/^[6-9]\d{9}$/.test(v.mobile)){ return fail("Please enter a valid 10-digit Indian mobile number (starting 6–9)."); }
    if(!document.getElementById('bkConsent').checked){ return fail("Please tick the consent box so we can proceed with your booking."); }
    if(v.mode==='home' && !v.address){ return fail("Please add the home address for collection."); }
    if(v.mode==='scheduled' && !v.dateTime){ return fail("Please pick your preferred date & time."); }
    if(v.dateTime){ var dt=new Date(v.dateTime); if(!isNaN(dt) && dt.getTime() < Date.now()-60000){ return fail("Please choose a date & time in the future."); } }
    err.style.display="none";

    var sub = document.getElementById('bkSub');
    sub.disabled = true; sub.innerHTML = '<span class="bk-spin"></span> Booking…';

    var payload = {
      fullName:v.name, mobile:v.mobile, email:v.email, age:v.age, gender:v.gender,
      mode:v.mode, address:v.address, dateTime:v.dateTime,
      website:(document.getElementById('bkHp')||{}).value||"",   // honeypot (bots only)
      items: CART.map(function(it){ return { name:it.name, code:it.code||undefined }; })
    };

    var timedOut = false;
    var ac = (typeof AbortController!=='undefined') ? new AbortController() : null;
    var timer = setTimeout(function(){ timedOut = true; if(ac){ try{ac.abort();}catch(e){} } bkTimeout(v); }, 15000);

    fetch('/api/book', {
      method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload), signal: ac?ac.signal:undefined
    }).then(function(r){ return r.json().then(function(j){ return {status:r.status, j:j}; }); })
    .then(function(res){
      if(timedOut) return;
      clearTimeout(timer);
      var j = res.j || {};
      if(res.status>=200 && res.status<300 && j.ok){
        if(typeof gtag==='function'){gtag('event','booking_success',{event_category:'booking'});}  // no test name (health-data privacy)
        if(typeof fbq==='function'){fbq('track','Schedule');}  // no test name sent to Meta (health-data compliance)
        var done = document.getElementById('bkDone');
        document.getElementById('bkFormWrap').style.display="none";
        done.style.display="";
        var ref = j.billId ? ('<div class="ref">Booking Ref #'+j.billId+'</div>') : '';
        var _bookedNames = CART.map(function(it){return esc(it.name);}).join(", ");
        var _waUrl = bkWhatsAppUrl(v);   // build while cart is still populated
        done.innerHTML = '<div class="tick">✓</div>'
          + '<h4>Booking confirmed!</h4>'
          + '<p>Thank you, '+esc(v.name)+'. Your booking for <b>'+_bookedNames+'</b> is registered with Caspian.</p>'
          + ref
          + '<p style="margin-top:8px">'
          + (v.mode==='now'
              ? 'Show this Booking Ref at our centre and we\'ll have your tests ready — payment is collected at the counter.'
              : 'Our team will call you shortly on <b>'+esc(v.mobile)+'</b> to confirm the details'+(v.mode==='home'?' and your home-collection slot':' and your slot')+'.')
          + '</p>'
          + '<p style="margin-top:6px;color:#64748b;font-size:13.5px">You\'ll also receive a WhatsApp confirmation from our team within 15 minutes.</p>'
          + '<a class="btn-wa2" href="'+_waUrl+'" target="_blank" rel="noopener">Message us on WhatsApp</a>';
        CART = []; saveCart(); updateSticky();   // order placed — clear the cart
      } else {
        // notConfigured / notMapped / any API error → WhatsApp, no dead ends
        bkFallback(v, j.notConfigured ? 'not_configured' : (j.notMapped ? 'not_mapped' : ('http_'+res.status)));
      }
    })
    .catch(function(){ if(timedOut) return; clearTimeout(timer); bkFallback(v,'network'); });
  });

  /* ===== Conversion tracking: WhatsApp booking & phone clicks ===== */
  document.addEventListener('click', function(e){
    var wa = e.target.closest('a[href*="wa.me"], a[href*="api.whatsapp"], a[href*="whatsapp.com"]');
    if(wa){
      if(typeof gtag==='function'){gtag('event','whatsapp_click',{event_category:'engagement',event_label:(wa.href||'').split('?')[0]});}
      if(typeof fbq==='function'){fbq('track','Contact',{method:'whatsapp'});}
      return;
    }
    var rev = e.target.closest('a[href*="g.page"]');
    if(rev){
      if(typeof gtag==='function'){gtag('event','review_click',{event_category:'engagement'});}
      if(typeof fbq==='function'){fbq('track','Lead',{content_name:'google_review'});}
      return;
    }
    var tel = e.target.closest('a[href^="tel:"]');
    if(tel){
      if(typeof gtag==='function'){gtag('event','phone_click',{event_category:'engagement'});}
      if(typeof fbq==='function'){fbq('track','Contact',{method:'phone'});}
      return;
    }
    var eka = e.target.closest('a[href*="eka.care"]');
    if(eka){
      if(typeof gtag==='function'){gtag('event','eka_consult_click',{event_category:'engagement'});}
      if(typeof fbq==='function'){fbq('track','Lead',{content_name:'eka_consult'});}
    }
  });

  /* ===== Restore any saved cart (survives refresh / shared-link navigation) ===== */
  loadCart(); updateSticky();
</script>
