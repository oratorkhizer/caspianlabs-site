<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
<link rel="preconnect" href="https://connect.facebook.net" crossorigin>
<link rel="preconnect" href="https://elfsightcdn.com" crossorigin>
<link rel="icon" type="image/webp" href="data:image/webp;base64,">
<link rel="apple-touch-icon" href="data:image/webp;base64,">
<title>Caspian Diagnostic Centre | Diagnostic Lab in Hyderabad</title>
<meta name="description" content="Caspian Diagnostic Centre, Hyderabad — accurate pathology testing, health checkup packages, and home sample collection. Committed for accuracy & quality. Book online in seconds.">
<style>
  :root{
    --blue:#0A5C9E; --blue-dark:#08487d; --blue-800:#063a66;
    --teal:#14B8A6; --teal-dark:#0f9488;
    --ink:#152b3c; --muted:#5b6b7a; --line:#e3ecf3;
    --bg:#ffffff; --bg-soft:#f2f8fd; --bg-blue:#eaf3fb;
    --shadow:0 10px 30px rgba(10,92,158,.10); --shadow-sm:0 4px 14px rgba(10,92,158,.08);
    --radius:16px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;scroll-padding-top:84px;overflow-x:hidden}
  body{font-family:'Segoe UI',system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif;color:var(--ink);line-height:1.6;background:var(--bg);-webkit-font-smoothing:antialiased;overflow-x:hidden}
  h1,h2,h3{line-height:1.2;font-weight:700;letter-spacing:-.01em}
  a{color:inherit;text-decoration:none}
  img{max-width:100%}
  .wrap{max-width:1160px;margin:0 auto;padding:0 22px}
  .btn{display:inline-flex;align-items:center;gap:9px;font-weight:600;font-size:15px;padding:13px 22px;border-radius:999px;border:2px solid transparent;cursor:pointer;transition:.2s;white-space:nowrap}
  .btn-wa{background:#25D366;color:#fff}
  .btn-wa:hover{background:#1eb457;transform:translateY(-1px)}
  .btn-primary{background:var(--blue);color:#fff}
  .btn-primary:hover{background:var(--blue-dark);transform:translateY(-1px)}
  .btn-ghost{background:transparent;color:var(--blue);border-color:#cfe1f1}
  .btn-ghost:hover{background:var(--bg-blue)}
  .btn-white{background:#fff;color:var(--blue)}
  .btn-white:hover{transform:translateY(-1px)}
  .sec{padding:74px 0}
  .sec-soft{background:var(--bg-soft)}
  .eyebrow{color:var(--teal-dark);font-weight:700;font-size:13px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:10px}
  .sec h2{font-size:clamp(26px,3.4vw,38px);margin-bottom:14px}
  .lead{color:var(--muted);font-size:17px;max-width:640px}
  .center{text-align:center;margin:0 auto}

  /* top bar */
  .topbar{background:var(--blue-800);color:#dbeafe;font-size:13.5px}
  .topbar .wrap{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:8px 22px;flex-wrap:wrap}
  .topbar a{color:#eaf3fb;font-weight:500}
  .topbar .ti{display:inline-flex;align-items:center;gap:6px}
  .topbar .sep{opacity:.4}

  /* nav */
  header.nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .nav .wrap{display:flex;align-items:center;justify-content:space-between;padding:12px 22px}
  .brand{display:flex;align-items:center;gap:11px}
  .brand .logo{width:42px;height:42px;flex:0 0 42px}
  .brand .bt{font-weight:800;font-size:19px;color:var(--blue);letter-spacing:-.02em;line-height:1}
  .brand .bs{font-size:11px;color:var(--muted);letter-spacing:.12em;text-transform:uppercase}
  nav.links{display:flex;align-items:center;gap:26px}
  nav.links a{font-weight:600;font-size:15px;color:var(--ink)}
  nav.links a:hover{color:var(--blue)}
  .nav-hosp{display:none}
  .nav-cta{display:flex;align-items:center;gap:10px}
  .nav-cart{position:relative;display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border:1.5px solid var(--line);background:#fff;border-radius:11px;color:var(--ink);cursor:pointer;transition:.15s;flex:0 0 auto;padding:0}
  .nav-cart:hover{border-color:#cfe1f1;color:var(--blue)}
  .nav-cart .nc-badge{position:absolute;top:-7px;right:-7px;background:var(--blue);color:#fff;font-size:11px;font-weight:800;min-width:19px;height:19px;border-radius:999px;display:flex;align-items:center;justify-content:center;padding:0 5px;box-shadow:0 0 0 2px #fff}
  .nav-cart .nc-badge[hidden]{display:none}
  .nav-cart.bump{animation:ncbump .35s ease}
  @keyframes ncbump{0%{transform:scale(1)}40%{transform:scale(1.22)}100%{transform:scale(1)}}
  @media(max-width:640px){ .nav-cart{display:none} }
  .menu-btn{display:none;background:none;border:0;cursor:pointer;padding:6px}
  .menu-btn span{display:block;width:24px;height:2.5px;background:var(--ink);margin:5px 0;border-radius:2px;transition:.2s}

  /* hero */
  .hero{position:relative;background:linear-gradient(135deg,#0A5C9E 0%,#0b6fb8 55%,#0f8fb0 100%);color:#fff;overflow:hidden}
  .hero::after{content:"";position:absolute;right:-140px;top:-120px;width:460px;height:460px;background:radial-gradient(circle,rgba(255,255,255,.14),transparent 70%);border-radius:50%}
  .hero::before{content:"";position:absolute;left:-100px;bottom:-160px;width:420px;height:420px;background:radial-gradient(circle,rgba(20,184,166,.22),transparent 70%);border-radius:50%}
  .hero .wrap{position:relative;z-index:2;display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding-top:66px;padding-bottom:72px}
  .hero h1{font-size:clamp(30px,4.6vw,50px);margin-bottom:16px}
  .hero p.sub{font-size:18px;color:#e6f2fb;max-width:520px;margin-bottom:26px}
  .hero .cta{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:26px}
  .hero .assure{display:flex;gap:22px;flex-wrap:wrap;font-size:14px;color:#e6f2fb}
  .hero .assure div{display:flex;align-items:center;gap:8px}
  .hero .tick{width:20px;height:20px;flex:0 0 20px;background:rgba(255,255,255,.2);border-radius:50%;display:grid;place-items:center;font-size:12px}
  .hero-card{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);border-radius:20px;padding:26px;backdrop-filter:blur(6px)}
  .hero-card h3{font-size:19px;margin-bottom:6px}
  .hero-card p{font-size:14px;color:#e6f2fb;margin-bottom:18px}
  .hero-card .step{display:flex;gap:13px;align-items:flex-start;margin-bottom:16px}
  .hero-card .num{width:30px;height:30px;flex:0 0 30px;background:#fff;color:var(--blue);border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:14px}
  .hero-card .step b{display:block;font-size:15px}
  .hero-card .step span{font-size:13px;color:#dbeafe}

  /* stats */
  .stats{background:#fff;margin-top:-38px;position:relative;z-index:5}
  .stats .grid{background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden}
  .stats .cell{padding:26px 20px;text-align:center;border-right:1px solid var(--line)}
  .stats .cell:last-child{border-right:0}
  .stats .n{font-size:30px;font-weight:800;color:var(--blue)}
  .stats .l{font-size:13.5px;color:var(--muted);margin-top:2px}

  /* services */
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:38px}
  .card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:26px;transition:.2s;box-shadow:var(--shadow-sm)}
  .card:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:#cfe1f1}
  .card .ic{width:52px;height:52px;border-radius:13px;background:var(--bg-blue);color:var(--blue);display:grid;place-items:center;margin-bottom:16px}
  .card h3{font-size:18px;margin-bottom:7px}
  .card p{font-size:14.5px;color:var(--muted)}

  /* packages */
  .pkgs{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:38px}
  .pkg{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column;box-shadow:var(--shadow-sm);transition:.2s}
  .pkg:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
  .pkg.feat{border:2px solid var(--blue)}
  .pkg .top{padding:22px 22px 16px;border-bottom:1px solid var(--line);position:relative}
  .pkg .tag{position:absolute;top:16px;right:16px;background:var(--teal);color:#fff;font-size:11px;font-weight:700;padding:4px 10px;border-radius:999px;letter-spacing:.04em}
  .pkg h3{font-size:19px;margin-bottom:4px}
  .pkg .cnt{font-size:13px;color:var(--teal-dark);font-weight:600}
  .pkg .price{padding:16px 22px 6px;font-size:14px;color:var(--muted)}
  .pkg .price b{font-size:26px;color:var(--ink);font-weight:800}
  .pkg ul{list-style:none;padding:8px 22px 20px;flex:1}
  .pkg li{font-size:14px;color:var(--muted);padding:5px 0 5px 24px;position:relative}
  .pkg li::before{content:"✓";position:absolute;left:0;color:var(--teal);font-weight:800}
  .pkg .act{padding:0 22px 22px}
  .pkg .act .btn{width:100%;justify-content:center}

  /* all tests directory */
  .dir-search{max-width:640px;margin:26px auto 8px;position:relative}
  .dir-search input{width:100%;font-size:16px;padding:15px 18px 15px 48px;border:2px solid var(--line);border-radius:999px;background:#fff;color:var(--ink);outline:none;transition:.2s;box-shadow:var(--shadow-sm)}
  .dir-search input:focus{border-color:var(--blue)}
  .dir-search .si{position:absolute;left:18px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:18px}
  .dir-chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:16px auto 0;max-width:820px}
  .dir-chip{background:#fff;border:1.5px solid var(--line);color:var(--muted);font-size:13px;font-weight:600;padding:7px 14px;border-radius:999px;cursor:pointer;transition:.15s}
  .dir-chip:hover{border-color:#cfe1f1;color:var(--blue)}
  .dir-chip.on{background:var(--blue);border-color:var(--blue);color:#fff}
  .dir-chip-pop{border-color:#f6c945;color:#a9791b;background:#fffdf5}
  .dir-chip-pop.on{background:#f6b21b;border-color:#f6b21b;color:#3a2a00}
  .ti-pop{display:inline-block;font-size:10.5px;font-weight:800;color:#a9791b;background:#fff5da;border:1px solid #f2d98a;border-radius:6px;padding:1px 6px;margin-left:6px;vertical-align:middle;white-space:nowrap}
  .dir-count{text-align:center;color:var(--muted);font-size:13.5px;margin:20px 0 6px}
  .dir-list{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:12px}
  .titem{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:15px 18px;box-shadow:var(--shadow-sm);transition:.15s}
  .titem:hover{border-color:#cfe1f1;transform:translateY(-2px)}
  .titem .ti-main{flex:1;min-width:0}
  .titem .ti-name{font-weight:700;font-size:15px;color:var(--ink);cursor:pointer;display:inline-block}
  .titem .ti-name:hover{color:var(--blue);text-decoration:underline;text-underline-offset:2px}
  .titem .ti-cat{font-size:12px;color:var(--teal-dark);font-weight:600;letter-spacing:.02em;margin-top:2px}
  .titem .ti-inc{font-size:12px;color:var(--muted);margin-top:4px;line-height:1.45}
  .titem .ti-inc b{color:var(--ink);font-weight:600}
  .dir-hit{background:#fff6d6;border-radius:3px;padding:0 2px;font-weight:700;color:#8a6d1b}
  .titem .ti-price{font-weight:800;font-size:16px;color:var(--blue);white-space:nowrap}
  .titem .ti-price small{display:block;font-weight:600;font-size:11px;color:var(--muted)}
  .titem .ti-ask{font-size:12.5px;color:var(--muted);font-weight:600;white-space:nowrap}
  .titem .ti-book{flex:0 0 auto;background:var(--blue);color:#fff;font-weight:700;font-size:13px;padding:9px 14px;border-radius:999px;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;transition:.15s}
  .titem .ti-book:hover{background:#1447b8}
  a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,.dir-chip:focus-visible,.bk-mode:focus-visible,.ti-share:focus-visible{outline:2px solid #1a56db;outline-offset:2px;border-radius:6px}
  .ti-share{flex:0 0 auto;background:#eef4ff;border:1px solid #d6e4ff;color:#1a56db;width:36px;height:36px;border-radius:50%;display:inline-grid;place-items:center;cursor:pointer;transition:.15s;padding:0}
  .ti-share:hover{background:#dbe8ff}
  .pkg .act .pkg-share{margin-top:10px;background:none;border:0;color:var(--blue);font-weight:600;font-size:13px;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
  .pkg .act .pkg-share:hover{text-decoration:underline}
  /* share popover */
  #sharePop{position:absolute;z-index:9998;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 12px 34px rgba(15,23,42,.2);padding:6px;display:none;min-width:180px}
  #sharePop.on{display:block}
  #sharePop .sp-title{font-size:11.5px;font-weight:700;color:var(--muted);padding:6px 10px 4px}
  #sharePop button{display:flex;align-items:center;gap:10px;width:100%;background:none;border:0;padding:10px 10px;border-radius:8px;font-size:14px;color:#0f2444;cursor:pointer;text-align:left;font-family:inherit}
  #sharePop button:hover{background:#f1f5f9}
  #toast{position:fixed;left:50%;bottom:88px;transform:translateX(-50%) translateY(20px);background:#0f2444;color:#fff;font-size:14px;font-weight:600;padding:11px 20px;border-radius:999px;box-shadow:0 8px 24px rgba(0,0,0,.25);opacity:0;pointer-events:none;transition:.25s;z-index:10000}
  @media(max-width:640px){ #toast{bottom:150px} }
  #toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
  .dir-empty{text-align:center;color:var(--muted);padding:34px 0;font-size:15px}
  .dir-portal{background:var(--bg-blue);border:1px dashed #bcdcf5;color:var(--blue-dark);border-radius:14px;padding:14px 18px;margin:22px auto 0;max-width:760px;text-align:center;font-size:13.5px}
  .dir-more-head{margin:26px 0 12px;padding-top:20px;border-top:1px dashed var(--line);font-size:13.5px;color:var(--muted)}
  .dir-more-head b{color:var(--blue-dark)}
  .titem.cat-item .ti-price{font-size:13px;color:var(--muted);font-weight:600}
  @media(max-width:640px){.dir-list{grid-template-columns:1fr}.titem .ti-book span{display:none}}

  /* why / features */
  .feat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:26px;margin-top:36px}
  .frow{display:flex;gap:16px;align-items:flex-start}
  .frow .ic{width:46px;height:46px;flex:0 0 46px;border-radius:12px;background:var(--bg-blue);color:var(--blue);display:grid;place-items:center}
  .frow h3{font-size:17px;margin-bottom:3px}
  .frow p{font-size:14.5px;color:var(--muted)}

  /* home collection band */
  .band{background:linear-gradient(120deg,var(--blue) 0%,var(--teal-dark) 130%);color:#fff;border-radius:22px;padding:44px;display:grid;grid-template-columns:1.4fr auto;gap:30px;align-items:center}
  .band h2{color:#fff;font-size:clamp(24px,3vw,32px);margin-bottom:10px}
  .band p{color:#e6f2fb;max-width:560px}
  .band .act{display:flex;gap:12px;flex-wrap:wrap}

  /* about */
  .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
  .about-grid .imgbox{background:linear-gradient(135deg,#eaf3fb,#e5f6f3);border:1px solid var(--line);border-radius:var(--radius);min-height:320px;display:grid;place-items:center;text-align:center;padding:30px;color:var(--blue)}
  .about p{color:var(--muted);margin-bottom:14px}
  .chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px}
  .chip{background:var(--bg-blue);color:var(--blue-dark);font-size:13px;font-weight:600;padding:7px 14px;border-radius:999px}

  /* contact */
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:34px}
  .cbox{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:14px;box-shadow:var(--shadow-sm)}
  .cbox iframe{width:100%;height:340px;border:0;border-radius:12px;display:block}
  .cinfo .row{display:flex;gap:15px;align-items:flex-start;margin-bottom:22px}
  .cinfo .ic{width:46px;height:46px;flex:0 0 46px;border-radius:12px;background:var(--bg-blue);color:var(--blue);display:grid;place-items:center}
  .cinfo .row b{display:block;font-size:16px;margin-bottom:2px}
  .cinfo .row span,.cinfo .row a{font-size:14.5px;color:var(--muted)}
  .cinfo .row a:hover{color:var(--blue)}

  /* footer */
  footer{background:var(--blue-800);color:#cde2f2;padding:52px 0 24px;font-size:14.5px}
  footer .cols{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:34px;margin-bottom:34px}
  footer h4{color:#fff;font-size:16px;margin-bottom:14px}
  footer a{color:#cde2f2;display:block;padding:4px 0}
  footer a:hover{color:#fff}
  footer .fbrand{display:flex;align-items:center;gap:10px;margin-bottom:12px}
  footer .fbrand .bt{color:#fff;font-weight:800;font-size:18px}
  footer .bottom{border-top:1px solid rgba(255,255,255,.15);padding-top:18px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:13px;color:#a9c8e0}

  /* floating whatsapp */
  .fab{position:fixed;right:20px;bottom:20px;z-index:60;background:#25D366;color:#fff;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;box-shadow:0 8px 24px rgba(37,211,102,.5);transition:.2s}
  .fab:hover{transform:scale(1.08)}

  .note{background:#fff8e6;border:1px dashed #e8c65a;color:#8a6d1b;font-size:13.5px;border-radius:12px;padding:12px 16px;margin-top:22px}
  .note b{color:#6b520f}

  @media(max-width:900px){
    .hero .wrap{grid-template-columns:1fr;gap:28px}
    .about-grid,.contact-grid,.band{grid-template-columns:1fr}
    .band{text-align:left;padding:30px}
    .cards,.pkgs{grid-template-columns:repeat(2,1fr)}
    .feat-grid{grid-template-columns:1fr}
    .stats .grid{grid-template-columns:repeat(2,1fr)}
    .stats .cell:nth-child(2){border-right:0}
    .stats .cell{border-bottom:1px solid var(--line)}
    footer .cols{grid-template-columns:1fr 1fr;gap:24px}
  }
  @media(max-width:640px){
    nav.links{position:fixed;top:0;right:0;height:100vh;width:78%;max-width:320px;background:#fff;flex-direction:column;align-items:flex-start;padding:80px 28px;gap:8px;box-shadow:-10px 0 40px rgba(0,0,0,.15);transform:translateX(100%);visibility:hidden;transition:transform .3s ease,visibility .3s}
    nav.links.open{transform:translateX(0);visibility:visible}
    nav.links a{padding:12px 0;width:100%;border-bottom:1px solid var(--line)}
    .menu-btn{display:block;z-index:70}
    nav.links a.nav-hosp{display:block;color:var(--blue);font-weight:700}
    .nav-cta .btn-ghost{display:none}
    .cards,.pkgs{grid-template-columns:1fr}
    .topbar .hide-sm{display:none}
    .sec{padding:52px 0}
    .band{padding:24px}
    footer .cols{grid-template-columns:1fr;gap:20px}
    .band .act .btn{width:100%;justify-content:center}
  }

  .logo-img{height:46px;width:auto;display:block}
  .foot-logo{background:#fff;padding:9px 15px;border-radius:11px;display:inline-block;line-height:0}
  .foot-logo img{height:42px;width:auto;display:block}
  @media(max-width:640px){.logo-img{height:38px}}
  .ftag{color:#8fd3ff;font-style:italic;font-weight:600;font-size:14px;margin-top:10px}

  .blogo{width:40px;height:40px;flex:0 0 40px}
  .btwrap{display:flex;flex-direction:column;line-height:1}
  .bt{font-weight:800;font-size:20px;color:var(--blue);letter-spacing:-.02em}
  .bs{font-size:10px;color:var(--muted);letter-spacing:.16em;text-transform:uppercase;margin-top:2px}
  .fbt{color:#fff;font-weight:800;font-size:18px}

  /* FAQ */
  .faq-item{background:#fff;border:1px solid var(--line);border-radius:12px;margin-bottom:12px;box-shadow:var(--shadow-sm);overflow:hidden}
  .faq-item summary{list-style:none;cursor:pointer;padding:17px 22px;font-weight:600;font-size:16px;color:var(--ink);display:flex;justify-content:space-between;align-items:center;gap:14px}
  .faq-item summary::-webkit-details-marker{display:none}
  .faq-item summary::after{content:"+";font-size:24px;font-weight:400;color:var(--blue);transition:.2s;flex:0 0 auto;line-height:1}
  .faq-item[open] summary::after{transform:rotate(45deg)}
  .faq-item summary:hover{color:var(--blue)}
  .faq-item p{padding:0 22px 18px;color:var(--muted);font-size:15px}

  /* ===== Brand logo (inlined) ===== */
