  var _shareName="", _sharePrice=null;
  function shareUrl(name){ return location.origin + location.pathname + '?test=' + encodeURIComponent(name); }
  function openSharePop(name, price, btn){
    _shareName=name; _sharePrice=(price===""||price==null)?null:Number(price);
    var pop=document.getElementById('sharePop');
    document.getElementById('spNative').style.display = navigator.share ? 'flex' : 'none';
    pop.classList.add('on');
