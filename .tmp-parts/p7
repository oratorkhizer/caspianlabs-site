    var pw=pop.offsetWidth||190, ph=pop.offsetHeight||170;
    var vl=r.right-pw; if(vl<8)vl=8; if(vl+pw>window.innerWidth-8)vl=Math.max(8,window.innerWidth-pw-8);
    var vt=r.bottom+8; if(vt+ph>window.innerHeight-8)vt=Math.max(8,r.top-ph-8);
    pop.style.top=(window.scrollY+vt)+'px'; pop.style.left=(window.scrollX+vl)+'px';
  }
  window.addEventListener('resize', function(){ closeSharePop(); });
