  function shareVia(how){
    var name=_shareName, url=shareUrl(name);
    var label=(_sharePrice!=null ? name+' ('+inr(_sharePrice)+')' : name);
    var msg='Recommended: '+label+' at Caspian Diagnostic Centre. Book online here: '+url;
    if(how==='copy'){
      if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(url).then(function(){showToast('Link copied!');},function(){legacyCopy(url);showToast('Link copied!');}); }
      else { legacyCopy(url); showToast('Link copied!'); }
    } else if(how==='whatsapp'){ window.open('https://wa.me/?text='+encodeURIComponent(msg),'_blank','noopener'); }
    else if(how==='email'){ window.location.href='mailto:?subject='+encodeURIComponent('Caspian Diagnostic Centre — '+name)+'&body='+encodeURIComponent(msg); }
    else if(how==='native' && navigator.share){ navigator.share({title:name,text:label+' at Caspian Diagnostic Centre',url:url}).catch(function(){}); }
