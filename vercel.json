{
  "buildCommand": "node scripts/inject-optin.mjs",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "caspianlabs.in" }],
      "destination": "https://www.caspianlabs.in/$1",
      "permanent": true
    },
    { "source": "/tests/inbody-body-composition-test-hyderabad", "destination": "/tests/body-composition-analysis-test-hyderabad", "permanent": true },
    { "source": "/fibroscan", "destination": "https://www.caspianhealthcare.in/camps/fibroscan", "permanent": true },
    { "source": "/camps/fibroscan", "destination": "https://www.caspianhealthcare.in/camps/fibroscan", "permanent": true },
    { "source": "/body-composition", "destination": "https://www.caspianhealthcare.in/body-composition", "permanent": true },
    { "source": "/bca", "destination": "https://www.caspianhealthcare.in/body-composition", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/tests", "destination": "/api/page?kind=tests" },
    { "source": "/packages", "destination": "/api/page?kind=packages" },
    { "source": "/packages/:slug", "destination": "/api/page?kind=package&slug=:slug" },
    { "source": "/tests/:slug", "destination": "/api/page?kind=test&slug=:slug" },
    { "source": "/home-sample-collection-hyderabad", "destination": "/api/page?kind=home" },
    { "source": "/blog", "destination": "/api/blog" },
    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" },
    { "source": "/:path*", "destination": "/api/page?kind=404" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|gif|ico|woff|woff2|ttf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}
