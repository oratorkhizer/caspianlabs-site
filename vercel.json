{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "caspianlabs.in" }],
      "destination": "https://www.caspianlabs.in/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/", "destination": "/index (1).html" },
    { "source": "/index.html", "destination": "/index (1).html" },
    { "source": "/index-new", "destination": "/index (1).html" }
  ]
}
